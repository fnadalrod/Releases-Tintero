<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>app.tintero.Tintero</id>
    <name>Tintero</name>
    <summary>Multiplatform writing app for novels, scripts, RPGs, and essays</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>LicenseRef-proprietary</project_license>

    <description>
        <p>
            Tintero is a versatile, multiplatform writing studio designed for creative writers,
            students, and professionals. Use it to write novels, short stories, essays, screenplays,
            RPG campaigns, journals, school projects, or organize your studies.
        </p>
        <p>
            Work seamlessly across devices: continue your projects on Android, Windows, Mac, Linux,
            or any other supported platform.
        </p>
        <p>
            Enjoy structured writing with folders, chapters, and notes, optional worldbuilding tools,
            visual planning boards, drag-and-drop organization, offline file management, automatic
            saves, and productivity tracking. Tintero helps you focus, stay organized, and work
            efficiently, no matter where you are or what type of project you are developing.
        </p>
        <p>Available in English, Spanish, French, Italian, German, Portuguese and Catalan.</p>
    </description>

